# systemd unit for the tapo-sidecar (localhost python-kasa facade).
# Runs alongside champ-bridge on the same Pi. The bridge (champ-bridge)
# is the ONLY caller — the sidecar listens on 127.0.0.1 only.
# Install:
#   sudo cp deploy/champ-tapo-sidecar.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now champ-tapo-sidecar
# Logs:
#   sudo journalctl -u champ-tapo-sidecar -f
#
# Creds (TAPO_USERNAME/TAPO_PASSWORD) + addressing (TAPO_HOSTS) live in
# /home/pi/champ-bridge/sidecar/.env — chmod 600 it (see sidecar/README.md).
# Unlike champ-bridge this process stamps no timestamps, so it needs no
# time-sync ordering — only the network.

[Unit]
Description=tapo-sidecar — localhost python-kasa facade for champ-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/champ-bridge/sidecar
EnvironmentFile=/home/pi/champ-bridge/sidecar/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/champ-bridge/sidecar/.venv/bin/python tapo_sidecar.py
Restart=always
RestartSec=10
# Don't fight the OS for cycles — device polling is light.
Nice=5

# Hardening — mirrors champ-bridge.service. The sidecar is stateless
# (in-memory registry, no file writes), so ProtectHome=read-only needs
# no ReadWritePaths carve-out: it only reads .venv + .env under $HOME.
ProtectSystem=full
ProtectHome=read-only
PrivateTmp=true
NoNewPrivileges=true
# Cheap containment. The sidecar only listens on localhost and makes
# outbound TCP to the plugs/hub on the LAN — no bluetooth, no netlink.
# AF_INET/AF_INET6 for those sockets; AF_UNIX for python/asyncio internals.
MemoryMax=256M
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
