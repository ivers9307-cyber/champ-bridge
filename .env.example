# champ-bridge configuration. Copy to .env and fill in.

# Required.
CHAMP_BRIDGE_TOKEN=bbr_replace_with_token_from_crm
CHAMP_API_URL=https://crm.un1tdublin.com

# Dev — emit synthetic ANT+ + BLE straps without hardware.
# FAKE_STRAPS=1

# Protocols — both on by default. Set to 0 to disable one.
# ENABLE_ANT=0
# ENABLE_BLE=0

# Optional tuning.
# BATCH_INTERVAL_MS=3000
# SCAN_INTERVAL_MS=5000
# HEARTBEAT_MS=30000
# MAX_CONNECTIONS=30
# LOG_LEVEL=info

# Production logging.
# NODE_ENV=production
