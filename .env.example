# champ-bridge configuration. Copy to .env and fill in.

# Required.
CHAMP_BRIDGE_TOKEN=bbr_replace_with_token_from_crm
CHAMP_API_URL=https://crm.un1tdublin.com

# Dev — emit synthetic ANT+ + BLE straps without hardware.
# FAKE_STRAPS=1

# Protocols — both on by default. Set to 0 to disable one.
# ENABLE_ANT=0
# ENABLE_BLE=0

# Optional tuning. Interval values are clamped to a sane minimum, so a
# negative / tiny value can't busy-spin the poll loops.
# BATCH_INTERVAL_MS=3000   (min 500)
# SCAN_INTERVAL_MS=5000    (min 1000)
# HEARTBEAT_MS=30000       (min 5000)
# MAX_CONNECTIONS=30
# LOG_LEVEL=info

# InBody / Lookin'Body enrichment (optional). Only runs when BOTH
# INBODY_API_KEY and INBODY_ACCOUNT are set. The key is a secret — it lives
# only here on the Pi. Whitelist this Pi's public IP in the InBody portal
# (Step 2); find it with:  curl -s https://ifconfig.me
# INBODY_API_KEY=replace_with_webapi_key_from_inbody_portal
# INBODY_ACCOUNT=stillorganun1t
# INBODY_API_URL=https://apieur.lookinbody.com
# INBODY_POLL_MS=300000   (min 30000)
# INBODY_DAILY_CAP=450
# Where the daily-cap counter (day + calls-sent) is persisted so a restart
# doesn't reset it and risk breaching InBody's 500/day cap. Defaults to the
# working dir; set an absolute path (e.g. a systemd StateDirectory) if the
# working dir is read-only.
# INBODY_STATE_FILE=/var/lib/champ-bridge/inbody-daily-count.json

# Production logging.
# NODE_ENV=production
